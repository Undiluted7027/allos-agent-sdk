# Allos Agent SDK Environment Variables
# Copy this file to .env and fill in your API keys.
# DO NOT COMMIT the .env file to version control.

# OpenAI API Key
OPENAI_API_KEY="your_openai_api_key_here"

# Anthropic API Key
ANTHROPIC_API_KEY="your_anthropic_api_key_here"

# Together AI API Key
TOGETHER_API_KEY="your_together_ai_api_key_here"

# PortKey API Key
PORTKEY_API_KEY="your_portkey_api_key_here"

# Mistral AI API Key
MISTRAL_API_KEY="your_mistral_ai_api_key_here"

# OpenRouter API Key
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# Cohere API Key
COHERE_API_KEY="your_cohere_api_key_here"

# Deepseek API Key
DEEPSEEK_API_KEY="your_deepseek_api_key_here"

# Groq API Key
GROQ_API_KEY="your_groq_api_key_here"

# Gemini
GEMINI_API_KEY="your_gemini_api_key_here"

# Ollama
OLLAMA_HOST="your_ollama_server_url_here"

# Vertex AI
# GOGLE_API_KEY="your_google_vertex_api_key_here"
# GOOGLE_CLOUD_PROJECT="your_google_cloud_project_id_here"
# GOOGLE_CLOUD_LOCATION="your_google_cloud_location_here"
# GOOGLE_GENAI_VERTEXAI="True"
# GOOGLE_APPLICATION_CREDENTIALS="path_to_gcloud_creds_json_here"

# For Testing
TEST_OPENAI_API_KEY="test-openai-api-key"
TEST_ANTHROPIC_API_KEY="test-anthropic-api-key"
TEST_GEMINI_API_KEY="test-gemini-api-key"
TEST_GOOGLE_API_KEY="test-google-api-key"
